# Google OpenID Connect credentials and the exact callback URL registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8888/api/auth/google/callback

# Generate two different random secrets with at least 32 characters each.
JWT_SECRET_KEY=
SESSION_SECRET_KEY=

# Use AUTH_COOKIE_SECURE=true when serving the API over HTTPS.
AUTH_COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_SECONDS=28800
AUTH_SUCCESS_REDIRECT_URL=http://127.0.0.1:7777/
# PostgreSQL connection string used by the FastAPI application.
# Replace the password with your local PostgreSQL user's password.
DATABASE_URL=postgresql://dev_user:your_password@localhost:5432/fastapi_dev
